{
  "name": "finava",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u ANTHROPIC_API_KEY node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "vercel-build": "node node_modules/next/dist/bin/next build",
    "eval:smoke": "vitest run --config evals/vitest.config.ts",
    "eval:live": "env -u ANTHROPIC_API_KEY npx tsx --env-file=.env --env-file=.env.local evals/live/run.ts",
    "eval:panel": "env -u ANTHROPIC_API_KEY npx tsx --env-file=.env --env-file=.env.local evals/panel/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@langfuse/core": "^5.11.0",
    "@langfuse/openai": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/papaparse": "^5.5.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "marked": "^18.0.3",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "openai": "^6.39.1",
    "papaparse": "^5.5.3",
    "plaid": "^42.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^4.1.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "swr": "^2.4.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
