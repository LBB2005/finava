# Copy these entries into ignored .env.local. Existing Firebase, Alpaca,
# Anthropic and OpenRouter settings are also required for non-offline runs.
TYPESAFE_API_KEY=

# Confirm the direct-account input price, in USD per million input tokens.
# Do not copy the Vercel gateway price without checking the direct contract.
TOURNAMENT_JEV_INPUT_USD_PER_MILLION=
TOURNAMENT_DAILY_USD_CAP=8

# One verified dated source archive is required; a local directory wins.
TOURNAMENT_DATA_DIR=
TOURNAMENT_DATA_URL=
