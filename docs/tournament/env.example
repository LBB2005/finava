# Copy these entries into ignored .env.local. Existing Firebase, Alpaca,
# Anthropic and OpenRouter settings are also required for non-offline runs.
TYPESAFE_API_KEY=

# Published direct API price, USD per million input tokens; output free.
# https://docs.typesafe.ai/models verified 2026-09-28. Override for custom pricing.
TOURNAMENT_JEV_INPUT_USD_PER_MILLION=0.042
TOURNAMENT_DAILY_USD_CAP=8

# One verified dated source archive is required; a local directory wins.
TOURNAMENT_DATA_DIR=
TOURNAMENT_DATA_URL=
